# скопіювати в .env і заповнити
# порт плати: Linux /dev/ttyUSB1 (або /dev/serial/by-id/...), Windows COM3; без SWM_PORT порт шукається за SWM_VID
SWM_VID=0403
SWM_PORT=
# SWM_SERIAL=
WIFI_SSID=
WIFI_PASSWORD=
TEST_LOGIN=qa_swm
TEST_PASSWORD=
# HIL-стадії (Linux): Arduino-стимулятор кнопок і керований Wi-Fi
# BUTTON_STIM_PORT=/dev/ttyUSB0
# HIL_AP_CONNECTION=SENTRY-HIL
# HIL_UPSTREAM_CONNECTION=
